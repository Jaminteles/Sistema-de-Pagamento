{
  "name": "sistema-pagamento",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de Ponto e Pagamento - monorepo (apps/api, apps/web, packages/shared)",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build:shared": "pnpm --filter @sistema/shared build",
    "build:api": "pnpm --filter @sistema/api build",
    "build:web": "pnpm --filter @sistema/web build",
    "lint:shared": "pnpm --filter @sistema/shared lint",
    "lint:api": "pnpm --filter @sistema/api lint",
    "lint:web": "pnpm --filter @sistema/web lint",
    "test:api": "pnpm --filter @sistema/api test",
    "test:web": "pnpm --filter @sistema/web test",
    "typecheck:shared": "pnpm --filter @sistema/shared typecheck",
    "typecheck:api": "pnpm --filter @sistema/api typecheck",
    "typecheck:web": "pnpm --filter @sistema/web typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:validate": "pnpm --filter @sistema/api prisma:validate",
    "prisma:status": "pnpm --filter @sistema/api prisma:status",
    "ci:verify": "pnpm run lint:shared && pnpm run lint:api && pnpm run lint:web && pnpm run typecheck:shared && pnpm run typecheck:api && pnpm run typecheck:web && pnpm run test:api && pnpm run test:web && pnpm run build:shared && pnpm run build:api && pnpm run build:web"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.0"
  }
}

# Copie para .env e ajuste. O .env NUNCA e versionado.
# Nenhum segredo real deve ficar neste arquivo de exemplo.

# ---------------------------------------------------------------------------
# PostgreSQL 16
# ---------------------------------------------------------------------------
POSTGRES_USER=ponto
POSTGRES_PASSWORD=defina-uma-senha-forte
POSTGRES_DB=ponto_pagamento
# Porta exposta no host (o container sempre usa 5432 internamente).
# Se a maquina ja tiver um PostgreSQL nativo em 5432, use outra porta aqui
# e ajuste a DATABASE_URL abaixo.
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# API (NestJS)
# ---------------------------------------------------------------------------
NODE_ENV=development
API_PORT=3000

# Rodando a API no host (pnpm --filter @sistema/api start:dev):
DATABASE_URL=postgresql://ponto:defina-uma-senha-forte@localhost:5432/ponto_pagamento?schema=public
# Rodando a API no Docker Compose, troque o host por "postgres":
# DATABASE_URL=postgresql://ponto:defina-uma-senha-forte@postgres:5432/ponto_pagamento?schema=public

# Origem exata do front-end. CORS fica restrito a ela; nao use curinga.
CORS_ORIGIN=http://localhost:4200

# Desligue em producao.
SWAGGER_ENABLED=true

# ---------------------------------------------------------------------------
# Sessao: JWT de acesso e refresh token (T-008 / RNF-03)
# Gere valores aleatorios diferentes para cada segredo, com 32+ caracteres:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# NUNCA versione os valores reais.
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=troque-por-um-segredo-aleatorio-de-32-ou-mais
JWT_REFRESH_SECRET=outro-segredo-aleatorio-diferente-do-de-acesso
# Access token de curta duracao (segundos, 300 a 3600).
JWT_ACCESS_TTL_SEGUNDOS=900
# Validade do refresh token em dias (1 a 30).
JWT_REFRESH_TTL_DIAS=7

# ---------------------------------------------------------------------------
# Seed do administrador inicial (T-004)
# Usadas apenas por `pnpm --filter @sistema/api prisma:seed`.
# ---------------------------------------------------------------------------
SEED_ADMIN_NOME=Administrador
SEED_ADMIN_EMAIL=admin@empresa.com.br
SEED_ADMIN_SENHA=defina-uma-senha-de-12-ou-mais

# ---------------------------------------------------------------------------
# Front-end servido pelo Nginx no Docker Compose
# ---------------------------------------------------------------------------
WEB_PORT=8080

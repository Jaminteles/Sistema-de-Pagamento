{
  "name": "@sistema/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Enums e contratos de API compartilhados entre apps/api (NestJS) e apps/web (Angular)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.0"
  }
}

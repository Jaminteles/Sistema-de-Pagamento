// Schema do Sistema de Ponto e Pagamento.
//
// Convencoes obrigatorias do projeto:
//   - PK sempre uuid;
//   - timestamp sempre timestamptz; fuso de negocio America/Bahia (RNF-12);
//   - dia de ponto e vigencias sao `date`; marcacoes sao timestamptz;
//   - duracoes (horas, extras, atrasos, saldo) em MINUTOS INTEIROS, nunca float;
//   - valores financeiros em numeric(12,2) -> Prisma.Decimal -> string no JSON;
//   - empresa unica: nao existe empresa_id, filial_id nem tenant.
//
// Os enums abaixo espelham packages/shared/src/enums. Alterar um exige alterar o outro.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// Perfis fixos (secao 3 do Levantamento de Requisitos). Funcionario nao e usuario.
enum PerfilUsuario {
  ADMIN
  RH
  ENCARREGADO
  FINANCEIRO

  @@map("perfil_usuario")
}

enum SituacaoFuncionario {
  ATIVO
  AFASTADO
  DESLIGADO

  @@map("situacao_funcionario")
}

enum TipoChavePix {
  CPF
  CNPJ
  EMAIL
  TELEFONE
  ALEATORIA

  @@map("tipo_chave_pix")
}

enum AbrangenciaFeriado {
  NACIONAL
  ESTADUAL
  MUNICIPAL

  @@map("abrangencia_feriado")
}

/// RN-07: ABERTO -> EM_CONFERENCIA -> FECHADO. Reabrir exige motivo e auditoria.
enum StatusPeriodo {
  ABERTO
  EM_CONFERENCIA
  FECHADO

  @@map("status_periodo")
}

enum OcorrenciaDia {
  NORMAL
  FALTA
  FALTA_JUSTIFICADA
  ATESTADO
  FOLGA
  FERIAS
  AFASTAMENTO

  @@map("ocorrencia_dia")
}

/// RN-06: depois de ENVIADO_RH o encarregado nao altera mais o dia.
enum StatusEnvioDia {
  NAO_ENVIADO
  ENVIADO_RH
  CONFERIDO

  @@map("status_envio_dia")
}

enum TipoMarcacao {
  ENTRADA
  SAIDA_INTERVALO
  RETORNO_INTERVALO
  SAIDA

  @@map("tipo_marcacao")
}

enum OrigemMarcacao {
  MANUAL
  IMPORTADO
  AJUSTE

  @@map("origem_marcacao")
}

enum TipoValorPagar {
  SALARIO
  ADIANTAMENTO
  DIARIA
  AJUDA_CUSTO
  OUTROS

  @@map("tipo_valor_pagar")
}

enum OrigemValorPagar {
  IMPORTADO
  AVULSO

  @@map("origem_valor_pagar")
}

/// RN-10: lote APROVADO e imutavel; correcao vira novo lote.
enum StatusLotePagamento {
  RASCUNHO
  AGUARDANDO_APROVACAO
  APROVADO
  EM_ENVIO
  CONCLUIDO
  CANCELADO

  @@map("status_lote_pagamento")
}

/// RN-11: so vira PAGO apos confirmacao do banco.
enum StatusLoteItem {
  PENDENTE
  ENVIADO
  PAGO
  FALHOU
  DEVOLVIDO

  @@map("status_lote_item")
}

// ---------------------------------------------------------------------------
// M1 - Acesso e usuarios
// ---------------------------------------------------------------------------

model Usuario {
  id              String        @id @default(uuid(7)) @db.Uuid
  nome            String        @db.VarChar(120)
  email           String        @unique @db.VarChar(160)
  /// Hash argon2. Nunca retornado pela API, nunca gravado em log.
  senhaHash       String        @map("senha_hash") @db.VarChar(255)
  perfil          PerfilUsuario
  ativo           Boolean       @default(true)
  senhaAlteradaEm DateTime?     @map("senha_alterada_em") @db.Timestamptz(3)
  criadoEm        DateTime      @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm    DateTime      @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  /// Obras do encarregado (RN-05). Vazio para os outros perfis.
  obras             UsuarioObra[]
  ajustes           AjustePonto[]
  periodosFechados  Periodo[]       @relation("PeriodoFechadoPor")
  periodosReabertos Periodo[]       @relation("PeriodoReabertoPor")
  lotesMontados     LotePagamento[] @relation("LoteCriadoPor")
  lotesAprovados    LotePagamento[] @relation("LoteAprovadoPor")
  valoresLancados   ValorPagar[]
  logs              LogAuditoria[]

  @@index([perfil, ativo])
  @@map("usuario")
}

/// Vinculo N:N encarregado x obra. Base do escopo do encarregado (RN-05),
/// aplicado sempre no service/repository a partir do usuario autenticado.
model UsuarioObra {
  id        String   @id @default(uuid(7)) @db.Uuid
  usuarioId String   @map("usuario_id") @db.Uuid
  obraId    String   @map("obra_id") @db.Uuid
  criadoEm  DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  obra    Obra    @relation(fields: [obraId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, obraId])
  @@index([obraId])
  @@map("usuario_obra")
}

// ---------------------------------------------------------------------------
// M2 - Cadastros
// ---------------------------------------------------------------------------

model Obra {
  id           String   @id @default(uuid(7)) @db.Uuid
  nome         String   @unique @db.VarChar(160)
  endereco     String?  @db.VarChar(255)
  ativa        Boolean  @default(true)
  criadoEm     DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  encarregados UsuarioObra[]
  vinculos     VinculoFuncionario[]

  @@index([ativa])
  @@map("obra")
}

/// RF-009. Horarios guardados como minutos a partir da meia-noite, no fuso de
/// negocio: evita ambiguidade de timezone e mantem a regra "duracao em minutos".
model Jornada {
  id                  String   @id @default(uuid(7)) @db.Uuid
  nome                String   @unique @db.VarChar(120)
  entradaMinutos      Int      @map("entrada_minutos")
  saidaMinutos        Int      @map("saida_minutos")
  intervaloMinutos    Int      @map("intervalo_minutos")
  cargaSemanalMinutos Int      @map("carga_semanal_minutos")
  /// RN-02: tolerancia diaria, padrao 10 minutos (CLT art. 58, par. 1).
  toleranciaMinutos   Int      @default(10) @map("tolerancia_minutos")
  /// Dias de trabalho em ISO-8601 (1 = segunda ... 7 = domingo).
  diasSemana          Int[]    @map("dias_semana")
  ativa               Boolean  @default(true)
  criadoEm            DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm        DateTime @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  vinculos VinculoFuncionario[]

  @@map("jornada")
}

/// RF-006. CPF guardado so com digitos; mascarado na resposta da API para
/// perfis sem permissao (RNF-05).
model Funcionario {
  id           String              @id @default(uuid(7)) @db.Uuid
  nome         String              @db.VarChar(160)
  cpf          String              @unique @db.VarChar(11)
  matricula    String              @unique @db.VarChar(30)
  cargo        String?             @db.VarChar(120)
  admissao     DateTime            @db.Date
  desligamento DateTime?           @db.Date
  situacao     SituacaoFuncionario @default(ATIVO)
  criadoEm     DateTime            @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime            @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  dadosPagamento DadosPagamento?
  vinculos       VinculoFuncionario[]
  dias           DiaPonto[]
  valoresPagar   ValorPagar[]
  itensLote      LoteItem[]

  @@index([situacao])
  @@index([nome])
  @@map("funcionario")
}

/// RF-007 e RNF-04: chave Pix e conta criptografadas em repouso, com chave de
/// criptografia vinda de variavel de ambiente. Nunca expostas em claro ao front-end.
model DadosPagamento {
  id                    String        @id @default(uuid(7)) @db.Uuid
  funcionarioId         String        @unique @map("funcionario_id") @db.Uuid
  tipoChave             TipoChavePix? @map("tipo_chave")
  chavePixCriptografada String?       @map("chave_pix_criptografada")
  /// Trecho mascarado da chave, usado apenas para exibicao na interface.
  chavePixMascara       String?       @map("chave_pix_mascara") @db.VarChar(40)
  banco                 String?       @db.VarChar(10)
  agencia               String?       @db.VarChar(10)
  contaCriptografada    String?       @map("conta_criptografada")
  contaMascara          String?       @map("conta_mascara") @db.VarChar(40)
  /// RF-037: data da ultima validacao de titularidade junto ao banco.
  validadoEm            DateTime?     @map("validado_em") @db.Timestamptz(3)
  criadoEm              DateTime      @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm          DateTime      @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  funcionario Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Cascade)

  @@map("dados_pagamento")
}

/// RF-010: vinculo com vigencia. Apenas um vinculo aberto por funcionario
/// (indice parcial unico criado na migration).
model VinculoFuncionario {
  id             String    @id @default(uuid(7)) @db.Uuid
  funcionarioId  String    @map("funcionario_id") @db.Uuid
  obraId         String    @map("obra_id") @db.Uuid
  jornadaId      String    @map("jornada_id") @db.Uuid
  inicioVigencia DateTime  @map("inicio_vigencia") @db.Date
  fimVigencia    DateTime? @map("fim_vigencia") @db.Date
  criadoEm       DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm   DateTime  @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  funcionario Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Restrict)
  obra        Obra        @relation(fields: [obraId], references: [id], onDelete: Restrict)
  jornada     Jornada     @relation(fields: [jornadaId], references: [id], onDelete: Restrict)

  @@index([funcionarioId, inicioVigencia])
  @@index([obraId, inicioVigencia])
  @@map("vinculo_funcionario")
}

/// RF-011.
model Feriado {
  id          String             @id @default(uuid(7)) @db.Uuid
  data        DateTime           @db.Date
  descricao   String             @db.VarChar(160)
  abrangencia AbrangenciaFeriado
  uf          String?            @db.Char(2)
  municipio   String?            @db.VarChar(120)
  criadoEm    DateTime           @default(now()) @map("criado_em") @db.Timestamptz(3)

  @@unique([data, descricao])
  @@index([data])
  @@map("feriado")
}

// ---------------------------------------------------------------------------
// M3 e M4 - Ponto, apuracao e fechamento
// ---------------------------------------------------------------------------

/// RN-01: periodo mensal, competencia no formato AAAA-MM.
model Periodo {
  id               String        @id @default(uuid(7)) @db.Uuid
  competencia      String        @unique @db.Char(7)
  dataInicio       DateTime      @map("data_inicio") @db.Date
  dataFim          DateTime      @map("data_fim") @db.Date
  status           StatusPeriodo @default(ABERTO)
  fechadoEm        DateTime?     @map("fechado_em") @db.Timestamptz(3)
  fechadoPorId     String?       @map("fechado_por_id") @db.Uuid
  reabertoEm       DateTime?     @map("reaberto_em") @db.Timestamptz(3)
  reabertoPorId    String?       @map("reaberto_por_id") @db.Uuid
  /// RN-07: obrigatorio ao reabrir.
  motivoReabertura String?       @map("motivo_reabertura") @db.VarChar(500)
  criadoEm         DateTime      @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm     DateTime      @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  fechadoPor  Usuario? @relation("PeriodoFechadoPor", fields: [fechadoPorId], references: [id], onDelete: Restrict)
  reabertoPor Usuario? @relation("PeriodoReabertoPor", fields: [reabertoPorId], references: [id], onDelete: Restrict)

  dias         DiaPonto[]
  valoresPagar ValorPagar[]

  @@index([status])
  @@map("periodo")
}

/// Totais calculados pelo motor de apuracao (RF-020), sempre em minutos inteiros.
model DiaPonto {
  id                 String         @id @default(uuid(7)) @db.Uuid
  periodoId          String         @map("periodo_id") @db.Uuid
  funcionarioId      String         @map("funcionario_id") @db.Uuid
  data               DateTime       @db.Date
  ocorrencia         OcorrenciaDia  @default(NORMAL)
  statusEnvio        StatusEnvioDia @default(NAO_ENVIADO) @map("status_envio")
  minutosTrabalhados Int            @default(0) @map("minutos_trabalhados")
  minutosExtras50    Int            @default(0) @map("minutos_extras_50")
  minutosExtras100   Int            @default(0) @map("minutos_extras_100")
  minutosNoturnos    Int            @default(0) @map("minutos_noturnos")
  minutosAtraso      Int            @default(0) @map("minutos_atraso")
  minutosFalta       Int            @default(0) @map("minutos_falta")
  apuradoEm          DateTime?      @map("apurado_em") @db.Timestamptz(3)
  observacao         String?        @db.VarChar(500)
  criadoEm           DateTime       @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm       DateTime       @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  periodo     Periodo     @relation(fields: [periodoId], references: [id], onDelete: Restrict)
  funcionario Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Restrict)
  marcacoes   Marcacao[]

  @@unique([funcionarioId, data])
  @@index([periodoId, data])
  @@index([periodoId, statusEnvio])
  @@map("dia_ponto")
}

model Marcacao {
  id           String         @id @default(uuid(7)) @db.Uuid
  diaPontoId   String         @map("dia_ponto_id") @db.Uuid
  horario      DateTime       @db.Timestamptz(3)
  tipo         TipoMarcacao
  origem       OrigemMarcacao @default(MANUAL)
  criadoEm     DateTime       @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm DateTime       @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  diaPonto DiaPonto      @relation(fields: [diaPontoId], references: [id], onDelete: Cascade)
  ajustes  AjustePonto[]

  @@unique([diaPontoId, tipo])
  @@index([diaPontoId, horario])
  @@map("marcacao")
}

/// RF-017: todo ajuste guarda valor anterior, valor novo, justificativa e autor.
model AjustePonto {
  id            String    @id @default(uuid(7)) @db.Uuid
  marcacaoId    String    @map("marcacao_id") @db.Uuid
  valorAnterior DateTime? @map("valor_anterior") @db.Timestamptz(3)
  valorNovo     DateTime? @map("valor_novo") @db.Timestamptz(3)
  justificativa String    @db.VarChar(500)
  usuarioId     String    @map("usuario_id") @db.Uuid
  criadoEm      DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)

  marcacao Marcacao @relation(fields: [marcacaoId], references: [id], onDelete: Cascade)
  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([marcacaoId, criadoEm])
  @@map("ajuste_ponto")
}

// ---------------------------------------------------------------------------
// M5 e M6 - Valores a pagar e pagamentos Pix
// ---------------------------------------------------------------------------

/// RF-027 e RF-028. Valor sempre numeric(12,2) -> Prisma.Decimal -> string no JSON.
model ValorPagar {
  id            String           @id @default(uuid(7)) @db.Uuid
  funcionarioId String           @map("funcionario_id") @db.Uuid
  periodoId     String?          @map("periodo_id") @db.Uuid
  tipo          TipoValorPagar
  valor         Decimal          @db.Decimal(12, 2)
  origem        OrigemValorPagar
  descricao     String?          @db.VarChar(255)
  criadoPorId   String           @map("criado_por_id") @db.Uuid
  loteItemId    String?          @map("lote_item_id") @db.Uuid
  criadoEm      DateTime         @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm  DateTime         @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  funcionario Funcionario @relation(fields: [funcionarioId], references: [id], onDelete: Restrict)
  periodo     Periodo?    @relation(fields: [periodoId], references: [id], onDelete: Restrict)
  criadoPor   Usuario     @relation(fields: [criadoPorId], references: [id], onDelete: Restrict)
  loteItem    LoteItem?   @relation(fields: [loteItemId], references: [id], onDelete: SetNull)

  @@index([periodoId, funcionarioId])
  @@index([loteItemId])
  @@map("valor_pagar")
}

/// RN-09 (quem monta nao aprova) e RN-10 (lote aprovado e imutavel).
model LotePagamento {
  id            String              @id @default(uuid(7)) @db.Uuid
  descricao     String              @db.VarChar(255)
  status        StatusLotePagamento @default(RASCUNHO)
  criadoPorId   String              @map("criado_por_id") @db.Uuid
  aprovadoPorId String?             @map("aprovado_por_id") @db.Uuid
  total         Decimal             @default(0) @db.Decimal(12, 2)
  aprovadoEm    DateTime?           @map("aprovado_em") @db.Timestamptz(3)
  enviadoEm     DateTime?           @map("enviado_em") @db.Timestamptz(3)
  criadoEm      DateTime            @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm  DateTime            @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  criadoPor   Usuario  @relation("LoteCriadoPor", fields: [criadoPorId], references: [id], onDelete: Restrict)
  aprovadoPor Usuario? @relation("LoteAprovadoPor", fields: [aprovadoPorId], references: [id], onDelete: Restrict)

  itens LoteItem[]

  @@index([status, criadoEm])
  @@map("lote_pagamento")
}

/// RNF-07: idempotency_key unica por item garante que retry, clique duplo ou
/// webhook repetido nunca gerem Pix duplicado.
model LoteItem {
  id                    String         @id @default(uuid(7)) @db.Uuid
  loteId                String         @map("lote_id") @db.Uuid
  funcionarioId         String         @map("funcionario_id") @db.Uuid
  valor                 Decimal        @db.Decimal(12, 2)
  /// Chave Pix criptografada, copiada na montagem do lote (RNF-04).
  chavePixCriptografada String?        @map("chave_pix_criptografada")
  chavePixMascara       String?        @map("chave_pix_mascara") @db.VarChar(40)
  status                StatusLoteItem @default(PENDENTE)
  idBanco               String?        @map("id_banco") @db.VarChar(80)
  e2eId                 String?        @map("e2e_id") @db.VarChar(40)
  idempotencyKey        String         @unique @map("idempotency_key") @db.VarChar(80)
  erro                  String?        @db.VarChar(500)
  tentativas            Int            @default(0)
  enviadoEm             DateTime?      @map("enviado_em") @db.Timestamptz(3)
  pagoEm                DateTime?      @map("pago_em") @db.Timestamptz(3)
  criadoEm              DateTime       @default(now()) @map("criado_em") @db.Timestamptz(3)
  atualizadoEm          DateTime       @updatedAt @map("atualizado_em") @db.Timestamptz(3)

  lote        LotePagamento @relation(fields: [loteId], references: [id], onDelete: Restrict)
  funcionario Funcionario   @relation(fields: [funcionarioId], references: [id], onDelete: Restrict)

  valoresPagar ValorPagar[]

  @@index([loteId, status])
  @@index([funcionarioId])
  @@index([e2eId])
  @@map("lote_item")
}

// ---------------------------------------------------------------------------
// Auditoria
// ---------------------------------------------------------------------------

/// RF-005. `antes` e `depois` nunca guardam token, senha, segredo, certificado,
/// CPF completo nem chave Pix completa.
model LogAuditoria {
  id         String   @id @default(uuid(7)) @db.Uuid
  usuarioId  String?  @map("usuario_id") @db.Uuid
  acao       String   @db.VarChar(80)
  entidade   String   @db.VarChar(80)
  entidadeId String?  @map("entidade_id") @db.VarChar(80)
  antes      Json?
  depois     Json?
  ip         String?  @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(255)
  criadoEm   DateTime @default(now()) @map("criado_em") @db.Timestamptz(3)

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([entidade, entidadeId])
  @@index([usuarioId, criadoEm])
  @@index([criadoEm])
  @@map("log_auditoria")
}
